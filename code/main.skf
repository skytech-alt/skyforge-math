// ============================================
//   skf-math — супер-расширенная математика
//   от SkyMonder
// ============================================

// --------------------------------------------
//   БАЗОВЫЕ ОПЕРАЦИИ
// --------------------------------------------

функция абсолют(число) {
    подключить_питон("math")
    вернуть math.fabs(число)
}

функция знак(число) {
    // Возвращает -1, 0 или 1 в зависимости от знака
    подключить_питон("math")
    вернуть math.copysign(1, число)
}

функция округлить(число, знаков) {
    подключить_питон("builtins")
    вернуть round(число, знаков)
}

функция пол(число) {
    подключить_питон("math")
    вернуть math.floor(число)
}

функция потолок(число) {
    подключить_питон("math")
    вернуть math.ceil(число)
}

функция остаток(делимое, делитель) {
    подключить_питон("math")
    вернуть math.fmod(делимое, делитель)
}

функция модуль(число, модуль) {
    подключить_питон("builtins")
    вернуть число % модуль
}

// --------------------------------------------
//   СТЕПЕНИ И КОРНИ
// --------------------------------------------

функция степень(основание, показатель) {
    подключить_питон("math")
    вернуть math.pow(основание, показатель)
}

функция квадрат(число) {
    вернуть степень(число, 2)
}

функция куб(число) {
    вернуть степень(число, 3)
}

функция корень(число) {
    подключить_питон("math")
    вернуть math.sqrt(число)
}

функция корень_n(число, n) {
    // Корень n-й степени
    подключить_питон("math")
    вернуть math.pow(число, 1.0 / n)
}

функция гипотенуза(a, b) {
    // Длина гипотенузы по теореме Пифагора
    подключить_питон("math")
    вернуть math.hypot(a, b)
}

функция экспонента(число) {
    подключить_питон("math")
    вернуть math.exp(число)
}

// --------------------------------------------
//   ЛОГАРИФМЫ
// --------------------------------------------

функция логарифм(число) {
    // Натуральный логарифм
    подключить_питон("math")
    вернуть math.log(число)
}

функция логарифм10(число) {
    подключить_питон("math")
    вернуть math.log10(число)
}

функция логарифм2(число) {
    подключить_питон("math")
    вернуть math.log2(число)
}

функция логарифм_по(число, основание) {
    подключить_питон("math")
    вернуть math.log(число, основание)
}

// --------------------------------------------
//   ТРИГОНОМЕТРИЯ (углы в градусах)
// --------------------------------------------

функция в_радианы(градусы) {
    подключить_питон("math")
    вернуть math.radians(градусы)
}

функция в_градусы(радианы) {
    подключить_питон("math")
    вернуть math.degrees(радианы)
}

функция синус(угол) {
    подключить_питон("math")
    вернуть math.sin(в_радианы(угол))
}

функция косинус(угол) {
    подключить_питон("math")
    вернуть math.cos(в_радианы(угол))
}

функция тангенс(угол) {
    подключить_питон("math")
    вернуть math.tan(в_радианы(угол))
}

функция арксинус(значение) {
    подключить_питон("math")
    вернуть в_градусы(math.asin(значение))
}

функция арккосинус(значение) {
    подключить_питон("math")
    вернуть в_градусы(math.acos(значение))
}

функция арктангенс(значение) {
    подключить_питон("math")
    вернуть в_градусы(math.atan(значение))
}

функция арктангенс2(y, x) {
    подключить_питон("math")
    вернуть в_градусы(math.atan2(y, x))
}

// --------------------------------------------
//   ГИПЕРБОЛИЧЕСКИЕ ФУНКЦИИ
// --------------------------------------------

функция синус_гип(число) {
    подключить_питон("math")
    вернуть math.sinh(число)
}

функция косинус_гип(число) {
    подключить_питон("math")
    вернуть math.cosh(число)
}

функция тангенс_гип(число) {
    подключить_питон("math")
    вернуть math.tanh(число)
}

// --------------------------------------------
//   КОМБИНАТОРИКА
// --------------------------------------------

функция факториал(n) {
    подключить_питон("math")
    вернуть math.factorial(n)
}

функция сочетания(n, k) {
    // Число сочетаний из n по k (C(n, k))
    подключить_питон("math")
    вернуть math.comb(n, k)
}

функция размещения(n, k) {
    // Число размещений из n по k (A(n, k))
    подключить_питон("math")
    вернуть math.perm(n, k)
}

функция нод(a, b) {
    // Наибольший общий делитель
    подключить_питон("math")
    вернуть math.gcd(a, b)
}

функция нок(a, b) {
    // Наименьшее общее кратное
    подключить_питон("math")
    вернуть a * b // math.gcd(a, b)
}

// --------------------------------------------
//   ПРОСТЫЕ ЧИСЛА
// --------------------------------------------

функция простое_число?(n) {
    // Проверяет, является ли число простым
    если (n < 2) {
        вернуть ложь
    }
    пусть i = 2
    пока (i * i <= n) {
        если (n % i == 0) {
            вернуть ложь
        }
        i = i + 1
    }
    вернуть истина
}

функция следующее_простое(n) {
    // Находит следующее простое число после n
    пусть кандидат = n + 1
    пока (простое_число?(кандидат) == ложь) {
        кандидат = кандидат + 1
    }
    вернуть кандидат
}

функция разложить_на_множители(n) {
    // Возвращает список простых множителей числа
    пусть множители = []
    пусть делитель = 2
    
    пока (делитель * делитель <= n) {
        пока (n % делитель == 0) {
            множители.добавить(делитель)
            n = n // делитель
        }
        делитель = делитель + 1
    }
    
    если (n > 1) {
        множители.добавить(n)
    }
    
    вернуть множители
}

// --------------------------------------------
//   СТАТИСТИКА
// --------------------------------------------

функция среднее(список) {
    подключить_питон("statistics")
    вернуть statistics.mean(список)
}

функция медиана(список) {
    подключить_питон("statistics")
    вернуть statistics.median(список)
}

функция мода(список) {
    подключить_питон("statistics")
    вернуть statistics.mode(список)
}

функция стандартное_отклонение(список) {
    подключить_питон("statistics")
    вернуть statistics.stdev(список)
}

функция дисперсия(список) {
    подключить_питон("statistics")
    вернуть statistics.variance(список)
}

функция минимум(список) {
    подключить_питон("builtins")
    вернуть min(список)
}

функция максимум(список) {
    подключить_питон("builtins")
    вернуть max(список)
}

функция сумма(список) {
    подключить_питон("builtins")
    вернуть sum(список)
}

функция произведение(список) {
    пусть результат = 1
    для (x в список) {
        результат = результат * x
    }
    вернуть результат
}

// --------------------------------------------
//   КОМПЛЕКСНЫЕ ЧИСЛА
// --------------------------------------------

функция комплекс(действительная, мнимая) {
    подключить_питон("builtins")
    вернуть complex(действительная, мнимая)
}

функция модуль_комплексного(z) {
    подключить_питон("cmath")
    вернуть cmath.abs(z)
}

функция фаза(z) {
    подключить_питон("cmath")
    вернуть cmath.phase(z)
}

функция корень_комплексного(z) {
    подключить_питон("cmath")
    вернуть cmath.sqrt(z)
}

// --------------------------------------------
//   ГЕОМЕТРИЯ
// --------------------------------------------

функция площадь_круга(радиус) {
    подключить_питон("math")
    вернуть math.pi * radius * radius
}

функция длина_окружности(радиус) {
    подключить_питон("math")
    вернуть 2 * math.pi * радиус
}

функция площадь_прямоугольника(ширина, высота) {
    вернуть ширина * высота
}

функция площадь_треугольника(основание, высота) {
    вернуть 0.5 * основание * высота
}

функция площадь_треугольника_по_сторонам(a, b, c) {
    // Формула Герона
    пусть p = (a + b + c) / 2
    вернуть корень(p * (p - a) * (p - b) * (p - c))
}

функция объем_сферы(радиус) {
    подключить_питон("math")
    вернуть (4.0 / 3.0) * math.pi * радиус * радиус * радиус
}

функция объем_цилиндра(радиус, высота) {
    подключить_питон("math")
    вернуть math.pi * радиус * радиус * высота
}

функция объем_конуса(радиус, высота) {
    подключить_питон("math")
    вернуть (1.0 / 3.0) * math.pi * радиус * радиус * высота
}

// --------------------------------------------
//   КОНСТАНТЫ
// --------------------------------------------

функция пи() {
    подключить_питон("math")
    вернуть math.pi
}

функция е() {
    подключить_питон("math")
    вернуть math.e
}

функция тау() {
    подключить_питон("math")
    вернуть 2 * math.pi
}

функция бесконечность() {
    подключить_питон("math")
    вернуть math.inf
}

функция не_число() {
    подключить_питон("math")
    вернуть math.nan
}

// --------------------------------------------
//   ПРОВЕРКИ
// --------------------------------------------

функция конечное?(число) {
    подключить_питон("math")
    вернуть math.isfinite(число)
}

функция бесконечное?(число) {
    подключить_питон("math")
    вернуть math.isinf(число)
}

функция не_число?(число) {
    подключить_питон("math")
    вернуть math.isnan(число)
}

функция близко?(a, b, допуск) {
    // Проверяет, близки ли два числа с заданным допуском
    вернуть абсолют(a - b) <= допуск
}
